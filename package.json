{
  "name": "kaamconnect-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "start": "node server/index.js",
    "dev": "concurrently -n \"SERVER,BUILD_WATCH\" -c \"blue,green\" \"node server/index.js\" \"npm --prefix client run build -- --watch\"",
    "dev:split": "concurrently -n \"EXPRESS,VITE\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

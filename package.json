{
  "name": "kaamconnect-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"EXPRESS,VITE\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
